<style>
  body { font-family: -apple-system, Segoe UI, sans-serif; margin: 0; background: #f5f6f8; color: #1d2330; }
  header { background: #1d2330; color: #fff; padding: 14px 28px; display: flex; gap: 28px; align-items: center; }
  header h1 { font-size: 20px; margin: 0; }
  header a { color: #cfd6e4; text-decoration: none; }
  header a:hover { color: #fff; }
  main { padding: 24px 28px; }
  h2 { margin: 8px 0 16px; }
  h3 { margin: 0 0 12px; font-size: 16px; }
  a { color: #2f6fed; }
  .filters { display: flex; gap: 10px; margin-bottom: 12px; }
  select, button, input { padding: 8px 10px; border-radius: 6px; border: 1px solid #c7ccd6; font-size: 14px; }
  button { background: #2f6fed; color: #fff; border: none; cursor: pointer; margin: 4px 4px 4px 0; }
  .muted { color: #6b7280; font-size: 13px; }
  table { width: 100%; border-collapse: collapse; background: #fff; }
  th, td { padding: 10px 12px; text-align: left; font-size: 14px; border-bottom: 1px solid #eceef2; }
  th { background: #eef1f6; }
  .card { background: #fff; border-radius: 10px; padding: 18px; margin-bottom: 16px; box-shadow: 0 1px 2px rgba(0,0,0,.05); }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .stack { display: flex; flex-direction: column; gap: 10px; max-width: 360px; margin-top: 10px; }
  label { display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: #374151; }
  .flash { margin: 16px 28px 0; padding: 12px 16px; border-radius: 8px; font-size: 14px; }
  .ok { background: #d1fae5; color: #065f46; }
  .err { background: #fee2e2; color: #991b1b; }
  .badge { padding: 3px 8px; border-radius: 10px; font-size: 12px; font-weight: 600; background: #e5e7eb; }
  .DELIVERED { background: #d1fae5; color: #065f46; }
  .RTO { background: #fee2e2; color: #991b1b; }
  .ATTEMPT_FAILED, .FAILED { background: #fef3c7; color: #92400e; }
  .OUT_FOR_DELIVERY { background: #dbeafe; color: #1e40af; }
</style>
<header>
  <h1>RTO Analyzer</h1>
  <a href="/shipments">Shipments</a>
  <a href="/shipments/new">New Shipment</a>
    <a href="/analytics">Analytics</a>
</header>
<c:if test="${not empty msg}"><div class="flash ok">${msg}</div></c:if>
<c:if test="${not empty error}"><div class="flash err">${error}</div></c:if>